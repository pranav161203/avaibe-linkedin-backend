# Copy to .env and fill in. Never commit .env or share its values.

# ---- Django
# Settings module: config.settings.dev (manage.py default), config.settings.prod (gunicorn/Docker/Render default),
# config.settings.test (used by `manage.py test`). Only set this to override the default.
# DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Development only (prod always runs with DEBUG off)
DJANGO_DEBUG=true
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
ALLOWED_HOSTS=localhost,127.0.0.1
# Front-end origin(s) allowed to call the API and send changes
CORS_ORIGINS=http://localhost:5173

# ---- Database (PostgreSQL). Required in production.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/avaibe_django
# Tests use SQLite unless this is set (CI sets it to a throwaway PostgreSQL). Never point it at real data.
# TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/avaibe_test
# Only for the one-off `python manage.py import_legacy` from the previous FastAPI database
LEGACY_DATABASE_URL=

# ---- LinkedIn app (Developer Portal -> your app -> Auth tab)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/linkedin/callback
# Encrypts stored LinkedIn tokens. Generate once with:
#   .venv\Scripts\python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---- Sign-in (see docs/auth.md). Off = LOCAL MODE: no sign-in, every request acts as an owner.
# true turns on email + password sign-in. It is also on whenever Microsoft sign-in below is configured.
AUTH_ENABLED=false
# Signs the access tokens. Optional: derived from DJANGO_SECRET_KEY if empty. Changing it signs everyone out.
JWT_SIGNING_KEY=
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=7
# INVITATION_DAYS=7
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_MINUTES=15

# ---- Microsoft sign-in (Entra ID), see docs/microsoft-signin-setup.md. Optional next to email + password.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:5173/api/auth/callback
# Your work email(s): become Owner on first Microsoft sign-in. Comma-separated.
ADMIN_EMAILS=
# HTTPS-only cookies. Production defaults to true; leave false for http://localhost
COOKIE_SECURE=false
# Production, once the final domain is settled (browsers remember it): e.g. 31536000
# SECURE_HSTS_SECONDS=0

# ---- Claude (Anthropic API) for AI suggestions
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---- Development only
# 1 = serve the mock LinkedIn API at /mock-linkedin/ (dummy data, dev_tools/mock_linkedin). Never in production.
# MOCK_LINKEDIN=1
